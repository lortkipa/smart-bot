{
  "name": "smart-bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node scripts/dev.mjs backend",
    "dev:web": "node scripts/dev.mjs web",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "dev:mobile": "node scripts/dev.mjs mobile",
    "prod:up": "node scripts/prod.mjs up",
    "prod:down": "docker compose -f deploy/compose.yml --env-file .env down",
    "prod:logs": "docker compose -f deploy/compose.yml --env-file .env logs -f",
    "prod:web": "node scripts/prod.mjs web",
    "prod:desktop": "node scripts/prod.mjs desktop",
    "prod:mobile": "node scripts/prod.mjs mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @smart-bot/db generate",
    "db:migrate": "pnpm --filter @smart-bot/db migrate",
    "db:studio": "pnpm --filter @smart-bot/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}

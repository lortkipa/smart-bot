# Copied to .env by `pnpm bootstrap`. .env is git-ignored; never commit secrets.

# --- Postgres (dev runs in Docker via deploy/compose.dev.yml) ---
POSTGRES_USER=smartbot
POSTGRES_PASSWORD=smartbot
POSTGRES_DB=smartbot
# Host port for the dev database. Uncommon on purpose, so it doesn't clash with a local Postgres.
POSTGRES_PORT=54320
DATABASE_URL=postgres://smartbot:smartbot@localhost:54320/smartbot

# --- API server (dev) ---
SERVER_PORT=3000
LOG_LEVEL=info
# Extra browser origins allowed to call the API (comma-separated). Tauri's webview origins:
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# --- Prod stack (deploy/compose.yml) ---
# Port the server (API + built web app) is published on.
PROD_PORT=8080

# --- OpenAI (not used yet) ---
OPENAI_API_KEY=
